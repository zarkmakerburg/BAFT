index 0000000..6cf0a1e
--- /dev/null
+++ b/internal/tunnelnode/pki_stage_test.go
@@ -0,0 +1,148 @@
+package tunnelnode
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPrepareChangedHostPreservesLivePKI(t *testing.T) {
+	p := newPair(t)
+	p.build(t, "old-host")
+	for _, n := range []*node{p.ex, p.ir} {
+		if _, err := n.Finalize(context.Background(), "old-host"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	old, err := snapshotPKI(p.ex.pkiDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	config, _ := os.ReadFile(p.ex.liveConfig())
+	calls := len(p.ex.host.calls)
+	p.exp.PublicAddress = "127.0.0.2"
+	if _, err := p.ex.PrepareEX(context.Background(), "candidate", p.exp); err != nil {
+		t.Fatal(err)
+	}
+	now, err := snapshotPKI(p.ex.pkiDir())
+	if err != nil || !sameDigests(old, now) {
+		t.Fatal("prepare changed live certificate material")
+	}
+	if b, _ := os.ReadFile(p.ex.liveConfig()); string(b) != string(config) || len(p.ex.host.calls) != calls {
+		t.Fatal("prepare changed the live config or service")
+	}
+	if _, err := p.ex.Rollback(context.Background(), "candidate"); err != nil {
+		t.Fatal(err)
+	}
+	now, err = snapshotPKI(p.ex.pkiDir())
+	if err != nil || !sameDigests(old, now) || len(p.ex.host.calls) != calls {
+		t.Fatal("prepared abort disturbed live service")
+	}
+}
+
+func TestStagedPKICutoverFailureRestoresLiveIdentity(t *testing.T) {
+	for _, first := range []bool{false, true} {
+		for _, point := range []string{"tunnel-cutover:before-pki-exchange", "tunnel-cutover:after-pki-exchange"} {
+			t.Run(point+map[bool]string{true: "-first", false: "-edit"}[first], func(t *testing.T) {
+				p := newPair(t)
+				if !first {
+					p.build(t, "old")
+					for _, n := range []*node{p.ex, p.ir} {
+						if _, err := n.Finalize(context.Background(), "old"); err != nil {
+							t.Fatal(err)
+						}
+					}
+				}
+				old, err := snapshotPKI(p.ex.pkiDir())
+				if err != nil {
+					t.Fatal(err)
+				}
+				p.exp.PublicAddress = "127.0.0.2"
+				code, err := p.ex.PrepareEX(context.Background(), "next", p.exp)
+				if err != nil {
+					t.Fatal(err)
+				}
+				reply, err := p.ir.PrepareIR(context.Background(), "next", code, p.irp)
+				if err != nil {
+					t.Fatal(err)
+				}
+				p.ex.Fault = func(at string) error {
+					if at == point {
+						return errors.New("injected cutover failure")
+					}
+					return nil
+				}
+				if _, err := p.ex.CommitEX(context.Background(), "next", reply); err == nil {
+					t.Fatal("cutover failure acknowledged")
+				}
+				now, err := snapshotPKI(p.ex.pkiDir())
+				if err != nil || (first && len(now) != 0) || (!first && !sameDigests(old, now)) {
+					t.Fatal("failed cutover lost previous PKI")
+				}
+				if p.ex.activeID() != "" {
+					t.Fatal("successful abort retained claim")
+				}
+			})
+		}
+	}
+}
+
+func TestStagedPKIRefusesChangedMaterialBeforeLiveMutation(t *testing.T) {
+	for _, target := range []string{"candidate", "live", "symlink", "backup"} {
+		t.Run(target, func(t *testing.T) {
+			p := newPair(t)
+			p.build(t, "old")
+			for _, n := range []*node{p.ex, p.ir} {
+				if _, err := n.Finalize(context.Background(), "old"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			p.exp.PublicAddress = "127.0.0.2"
+			code, err := p.ex.PrepareEX(context.Background(), "next", p.exp)
+			if err != nil {
+				t.Fatal(err)
+			}
+			reply, err := p.ir.PrepareIR(context.Background(), "next", code, p.irp)
+			if err != nil {
+				t.Fatal(err)
+			}
+			path := filepath.Join(p.ex.candidatePKIDir("next"), "server.pem")
+			if target == "live" {
+				path = filepath.Join(p.ex.pkiDir(), "server.pem")
+			}
+			if target == "backup" {
+				err = os.Mkdir(p.ex.pkiDir()+".before-next", 0700)
+			} else if target == "symlink" {
+				if err = os.Remove(path); err == nil {
+					err = os.Symlink(filepath.Join(p.ex.pkiDir(), "server.pem"), path)
+				}
+			} else {
+				err = os.WriteFile(path, []byte("operator edit"), 0644)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			before, _ := snapshotPKI(p.ex.pkiDir())
+			calls := len(p.ex.host.calls)
+			cfg, _ := os.ReadFile(p.ex.liveConfig())
+			if _, err := p.ex.CommitEX(context.Background(), "next", reply); err == nil {
+				t.Fatal("changed material accepted")
+			}
+			after, err := snapshotPKI(p.ex.pkiDir())
+			if err != nil || !sameDigests(before, after) {
+				t.Fatal("refused cutover disturbed live tree/service")
+			}
+			for _, call := range p.ex.host.calls[calls:] {
+				if !strings.HasPrefix(call, "is-active ") && !strings.HasPrefix(call, "is-enabled ") {
+					t.Fatalf("refused cutover changed service: %s", call)
+				}
+			}
+			if b, _ := os.ReadFile(p.ex.liveConfig()); string(b) != string(cfg) {
+				t.Fatal("refused cutover changed config")
+			}
+		})
+	}
