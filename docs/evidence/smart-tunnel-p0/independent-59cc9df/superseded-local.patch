diff --git a/internal/tunnelnode/pki_stage.go b/internal/tunnelnode/pki_stage.go
new file mode 100644
index 0000000..c60848c
--- /dev/null
+++ b/internal/tunnelnode/pki_stage.go
@@ -0,0 +1,121 @@
+package tunnelnode
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+func (m *Manager) candidatePKIDir(id string) string { return m.pkiDir() + ".candidate-" + id }
+
+func (m *Manager) preparedPKIDir(t Txn) string {
+	if t.PKIStaged && !t.PKIReplaced {
+		return m.candidatePKIDir(t.ID)
+	}
+	return m.pkiDir()
+}
+
+// Parsing the config alone does not load or verify TLS certificates.
+func validatePreparedPKI(dir, host string, now time.Time) error {
+	if _, err := snapshotPKI(dir); err != nil {
+		return err
+	}
+	cert, err := tls.LoadX509KeyPair(filepath.Join(dir, "server.pem"), filepath.Join(dir, "server.key"))
+	if err != nil {
+		return fmt.Errorf("candidate server certificate/key invalid: %w", err)
+	}
+	leaf, err := x509.ParseCertificate(cert.Certificate[0])
+	if err != nil {
+		return err
+	}
+	ca, err := os.ReadFile(filepath.Join(dir, "ca.pem"))
+	if err != nil {
+		return err
+	}
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM(ca) {
+		return errors.New("candidate CA invalid")
+	}
+	if _, err := leaf.Verify(x509.VerifyOptions{Roots: roots, DNSName: host, CurrentTime: now, KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}); err != nil {
+		return fmt.Errorf("candidate certificate verification failed: %w", err)
+	}
+	return nil
+}
+
+// Persist intent before moving anything. Before exchange, restorePKI recognizes
+// the old live identity; after exchange, it recognizes the old backup identity.
+func (m *Manager) activatePreparedPKI(t *Txn) error {
+	if !t.PKIStaged || t.PKIReplaced {
+		return nil
+	}
+	live, err := snapshotPKI(m.pkiDir())
+	if err != nil || (t.HadPKI && !sameDigests(live, t.PreviousPKI)) || (!t.HadPKI && len(live) != 0) {
+		return errors.New("live PKI changed since preparation; cutover refused")
+	}
+	candidate := m.candidatePKIDir(t.ID)
+	next, err := snapshotPKI(candidate)
+	if err != nil || len(next) == 0 || !sameDigests(next, t.InstalledPKI) {
+		return errors.New("candidate PKI missing or changed; cutover refused")
+	}
+	host, err := os.ReadFile(filepath.Join(candidate, "host"))
+	if err != nil {
+		return err
+	}
+	if err := validatePreparedPKI(candidate, strings.TrimSpace(string(host)), m.Now()); err != nil {
+		return err
+	}
+	before := m.pkiDir() + ".before-" + t.ID
+	if _, err := os.Lstat(before); !errors.Is(err, os.ErrNotExist) {
+		return errors.New("PKI backup path occupied; cutover refused")
+	}
+	t.PKIReplaced = true
+	if err := m.writeTxn(*t); err != nil {
+		return err
+	}
+	if err := renameDurable(candidate, before); err != nil {
+		return err
+	}
+	if err := m.fault("tunnel-cutover:before-pki-exchange"); err != nil {
+		return err
+	}
+	current, err := snapshotPKI(m.pkiDir())
+	if err != nil || (t.HadPKI && !sameDigests(current, t.PreviousPKI)) || (!t.HadPKI && len(current) != 0) {
+		return errors.New("live PKI changed before exchange; cutover refused")
+	}
+	prepared, err := snapshotPKI(before)
+	if err != nil || !sameDigests(prepared, t.InstalledPKI) {
+		return errors.New("candidate PKI changed before exchange; cutover refused")
+	}
+	if len(live) == 0 {
+		err = renameDurable(before, m.pkiDir())
+	} else {
+		err = exchangeDirs(m.pkiDir(), before)
+	}
+	if err != nil {
+		return err
+	}
+	return m.fault("tunnel-cutover:after-pki-exchange")
+}
+
+func (m *Manager) cleanupCandidatePKI(t Txn) error {
+	if !t.PKIStaged {
+		return nil
+	}
+	dir := m.candidatePKIDir(t.ID)
+	got, err := snapshotPKI(dir)
+	if err != nil {
+		return err
+	}
+	if len(got) == 0 {
+		return nil
+	}
+	if !sameDigests(got, t.InstalledPKI) {
+		return errors.New("candidate PKI changed; cleanup refused")
+	}
+	return removeAllDurable(dir)
+}
