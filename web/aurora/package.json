{
  "name": "@baft/aurora-foundation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "build": "tsc",
    "check:generated": "node scripts/check-generated.mjs",
    "size": "node scripts/report-size.mjs",
    "test": "npm run typecheck && npm run check:generated && npm run size && node --test tests/*.test.mjs"
  },
  "devDependencies": { "typescript": "6.0.3" }
}
